{
  "manifest_version": 3,
  "name": "Paramount Control+",
  "version": "1.3.1",
  "minimum_chrome_version": "111",
  "description": "Unofficial Paramount+ playback controls for hiding the sidebar, choosing video quality, and viewing resolution and bitrate.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "Paramount Control+",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.paramountplus.com/*",
        "https://paramountplus.com/*"
      ],
      "js": ["quality/bitrate-meter.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.paramountplus.com/*",
        "https://paramountplus.com/*"
      ],
      "js": [
        "content.js",
        "quality-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "quality/index.js",
        "quality/config.js",
        "quality/manifest-parser.js",
        "quality/manifest-policy.js",
        "quality/network-hooks.js",
        "quality/recovery-controller.js",
        "quality/state.js",
        "quality/stream-model.js",
        "quality/url-analysis.js"
      ],
      "matches": [
        "https://www.paramountplus.com/*",
        "https://paramountplus.com/*"
      ]
    }
  ]
}
